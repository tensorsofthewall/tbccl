{
  "title": "TBCCL benchmark baseline catalog",
  "type": "object",
  "required": ["schema_version", "kind", "catalog_id", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "tbccl-bench-baseline/1"},
    "kind": {"enum": ["definitions", "snapshot"]},
    "catalog_id": {"type": "string"},
    "description": {"type": "string"},
    "created_utc": {"type": ["string", "null"]},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "campaign_id", "family", "benchmark_adapter", "metric_name", "unit", "aggregation", "direction", "validity"],
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string"},
          "title": {"type": "string"},
          "campaign_id": {"type": "string"},
          "family": {"enum": ["raw_network", "native_p2p", "native_staging", "native_async", "native_collective", "native_overlap", "torch_p2p", "torch_collective", "torch_async", "torch_ddp", "vllm_pipeline", "exo_pipeline"]},
          "benchmark_adapter": {"type": "string"},
          "hardware_profile": {"type": ["string", "null"]},
          "transport": {"type": ["string", "null"]},
          "backend": {"type": ["string", "null"]},
          "variant": {"type": ["string", "null"]},
          "device_pairing": {"type": ["string", "null"]},
          "memory_kind": {"type": ["string", "null"]},
          "data_direction": {"type": ["string", "null"]},
          "rank_count": {"type": ["integer", "null"], "minimum": 1},
          "payload_bytes": {"type": ["integer", "null"], "minimum": 0},
          "datatype": {"type": ["string", "null"]},
          "operation": {"type": ["string", "null"]},
          "algorithm": {"type": ["string", "null"]},
          "benchmark_mode": {"type": ["string", "null"]},
          "timing_scope": {"type": ["string", "null"]},
          "completion_semantics": {"type": ["string", "null"]},
          "instrumentation": {"enum": ["untraced", "traced", null]},
          "model_id": {"type": ["string", "null"]},
          "model_hash": {"type": ["string", "null"]},
          "quantization": {"type": ["string", "null"]},
          "stage_order": {"type": ["string", "null"]},
          "layer_split": {"type": ["string", "null"]},
          "workload": {"type": ["string", "null"]},
          "request_concurrency": {"type": ["integer", "null"], "minimum": 1},
          "sampling": {"type": ["string", "null"]},
          "runtime": {"type": ["string", "null"]},
          "client_placement": {"type": ["string", "null"]},
          "scheduling_mode": {"type": ["string", "null"]},
          "extra_dimensions": {"type": "object"},
          "software_versions": {"type": "object"},
          "metric_name": {"type": "string"},
          "unit": {"type": "string"},
          "aggregation": {"type": "string"},
          "direction": {"enum": ["lower_is_better", "higher_is_better"]},
          "output_tokens": {"type": ["integer", "null"], "minimum": 0},
          "warmup_excluded": {"type": ["boolean", "null"]},
          "replication_unit": {"enum": ["lifecycle", "repetition", "process", "request", null]},
          "min_independent_units": {"type": ["integer", "null"], "minimum": 1},
          "run_ids": {"type": "array", "items": {"type": "string"}},
          "sample_count": {"type": ["integer", "null"], "minimum": 0},
          "independent_lifecycle_count": {"type": ["integer", "null"], "minimum": 0},
          "value": {"type": ["number", "null"]},
          "variation": {"type": ["object", "null"]},
          "observations": {"type": "array", "items": {"type": "number"}},
          "pair_ids": {"type": "array", "items": {"type": "string"}},
          "source_artifacts": {"type": "array", "items": {"type": "object", "required": ["path"], "additionalProperties": false,
                                                          "properties": {"path": {"type": "string"}, "sha256": {"type": ["string", "null"]}}}},
          "validity": {"type": "object", "required": ["status"], "additionalProperties": false,
                       "properties": {"status": {"enum": ["valid", "exploratory", "invalid", "superseded"]}, "conditions": {"type": "array", "items": {"type": "string"}},
                                      "caveats": {"type": "array", "items": {"type": "string"}}}},
          "tolerance": {"type": ["object", "null"]},
          "corrections": {"type": "array", "items": {"type": "object", "required": ["id", "statement"], "additionalProperties": false,
                                                     "properties": {"id": {"type": "string"}, "statement": {"type": "string"}}}},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
